{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "automerge": true,
  "platformAutomerge": false,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update HDF5 version used in the Dockerfile",
      "managerFilePatterns": [
        "/^Dockerfile$/"
      ],
      "matchStrings": [
        "ARG HDF5_VERSION=(?<currentValue>[^\\s]+)"
      ],
      "depNameTemplate": "HDFGroup/hdf5",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^(?:hdf5[_-])?(?<version>[0-9].*)$"
    }
  ]
}
